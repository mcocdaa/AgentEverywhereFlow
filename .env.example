# ==============================================================================
# AgentEverywhereFlow (AEFlow) - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision-Language Model (VLM) Configuration
# ------------------------------------------------------------------------------
# Supported models: gpt-4o, claude-3-5-sonnet-20241022, qwen2-vl-72b-instruct, deepseek-vl, etc.
AEF_MODEL_NAME=gpt-4o

# API Key for your LLM / VLM provider (OpenAI, Anthropic, OpenRouter, DeepSeek, etc.)
AEF_API_KEY=your_api_key_here

# Base URL for OpenAI-compatible or provider-specific endpoints
# Default: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# Local / Ollama / vLLM: http://localhost:8000/v1
AEF_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Execution Engine & Automation Policy
# ------------------------------------------------------------------------------
# Execution mode:
# - "minimal": Python CodeAct REPL execution (e.g. click(x, y), type_text(), press(), wait())
# - "guarded": Granular JSON atomic tool calls with safety intercepts & approval gates
AEF_DEFAULT_MODE=minimal

# Maximum steps allowed per autonomous agent task loop (prevents runaway execution)
AEF_MAX_STEPS=25

# Timeout in seconds for individual execution actions
AEF_STEP_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. Security & Safety Gates
# ------------------------------------------------------------------------------
# Set to true to require user confirmation before executing potentially destructive actions
# (e.g., closing windows, pressing Enter on shell commands, dangerous hotkeys)
AEF_REQUIRE_HUMAN_CONFIRMATION=false

# ------------------------------------------------------------------------------
# 4. User Interface & Storage
# ------------------------------------------------------------------------------
# Global hotkey shortcut to summon the AEFlow HUD / target picker
AEF_SUMMON_HOTKEY=ctrl+shift+a

# Directory where step screenshots and debug artifacts are temporarily cached
AEF_SCREENSHOT_DIR=./.aef_cache/screenshots
